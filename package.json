{
  "name": "zoro-server",
  "version": "1.1.0",
  "private": true,
  "main": "server/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "client": "npm run dev --prefix client",
    "server": "nodemon server/server.js",
    "test": "node --test server/orchestrator/tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
